<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Macrow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/macrow_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Macrow</item>
    </style>

    <style name="Theme.Macrow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/macrow_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
